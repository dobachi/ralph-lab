# ralph-lab itself makes NO API calls. Agent CLIs (claude/codex/gemini) have
# their own auth. This file is for anything you want passed through to the
# agent CLI subprocess environment.

# --- OpenRouter (if the agent CLI supports it) ---
# OPENROUTER_API_KEY=sk-or-v1-...

# --- Agent CLI flags (skip permission prompts) ---
# CLAUDE_ARGS=--dangerously-skip-permissions
# CODEX_ARGS=--full-auto
# GEMINI_ARGS=--yolo

# --- Gate script env (loop-goal example) ---
# LOOP_GOAL_ROOT=~/.claude/plugins/cache/dobachi-skills/loop-goal
